# =============================================================================
#  CardForge BLE - configuração da máquina
#
#  Copie para .env e ajuste. O setup.sh instala este arquivo em
#  /etc/cardforge/cardforge.env (permissão 640, só root e o serviço leem)
#  e troca a senha em texto puro por um hash.
# =============================================================================

# ----------------------------- Identidade ------------------------------------
# Nome anunciado no Bluetooth = MACHINE_MODEL-MACHINE_SERIAL
# Exemplo abaixo: CardForge-M1-001
MACHINE_MODEL=CardForge-M1
MACHINE_SERIAL=001

# ------------------------- Senha da máquina ----------------------------------
# Senha que o usuário digita no app (mínimo 6 caracteres).
# Se deixar o valor de exemplo, o setup.sh gera uma senha aleatória e mostra.
MACHINE_PASSWORD=troque-esta-senha

# Alternativa mais segura: só o hash (gere com
#   python cardforge_ble.py hash-password
# ). Se existir, MACHINE_PASSWORD é ignorada.
# MACHINE_PASSWORD_HASH=

# ------------------------------- Wi-Fi ---------------------------------------
WIFI_INTERFACE=wlan0
# Código do país (regulamentação do rádio). Sem isso o Wi-Fi fica bloqueado.
WIFI_COUNTRY=BR
# Tempo máximo (s) que a máquina tenta conectar no Wi-Fi recebido (5 a 120)
WIFI_CONNECT_TIMEOUT=20

# ----------------------------- Segurança -------------------------------------
# Senhas erradas seguidas antes de bloquear
AUTH_MAX_ATTEMPTS=5
# Bloqueio inicial (s); dobra a cada novo bloqueio, até 1 hora
AUTH_LOCKOUT_SECONDS=60
# Duração da sessão autenticada (s); termina antes se o app desconectar
SESSION_TTL_SECONDS=300
# Máximo de usuários permitidos salvos na máquina
MAX_ALLOWED_USERS=20

# ------------------------------- Sistema -------------------------------------
# Onde ficam os usuários permitidos e o machine_id (state.json).
# Mantenha o padrão: o serviço só tem permissão de escrita nessa pasta.
DATA_DIR=/var/lib/cardforge
# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
